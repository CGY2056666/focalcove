# 原型默认使用阿里云百炼 qwen3.8-27b；也可显式切换为 siliconflow。
FOCUS_VISION_PROVIDER=bailian

# 仅填写到本机 .env；不要把真实 Key 提交到仓库或发送给浏览器。
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.6-35B-A3B

BAILIAN_API_KEY=your_bailian_api_key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.8-27b

FOCUS_FRAME_INTERVAL_SECONDS=20
FOCUS_FRAME_DEADLINE_SECONDS=17
FOCUS_MODEL_TIMEOUT_SECONDS=16
FOCUS_MAX_IMAGE_EDGE=1024
FOCUS_DUPLICATE_THRESHOLD=6
FOCUS_SCORING_POLICY_PATH=

# 评测截图可能包含敏感信息；只在本地明确需要采集时开启。
FOCUS_EVAL_CAPTURE_ENABLED=false
FOCUS_EVAL_CAPTURE_DIR=evaluation/inbox

# Flask / Android API deployment. Production must use a random secret and HTTPS proxy.
FOCUS_ENV=development
FOCUS_APP_SECRET=replace_with_at_least_32_random_bytes
FOCUS_TRUST_PROXY_HEADERS=false
MOBILE_SESSIONS_JSON_PATH=mobile_sessions.json
MOBILE_TOKEN_TTL_SECONDS=2592000
MOBILE_AUTH_RATE_LIMIT=20
MOBILE_AUTH_RATE_WINDOW_SECONDS=60
MOBILE_FRAME_RATE_LIMIT=6
MOBILE_FRAME_RATE_WINDOW_SECONDS=60
BROWSER_AUTH_RATE_LIMIT=10
BROWSER_AUTH_RATE_WINDOW_SECONDS=900
MOBILE_CAPTURE_INTERVAL_SECONDS=20
MOBILE_CAPTURE_REQUEST_TIMEOUT_SECONDS=18
MOBILE_CAPTURE_MAX_EDGE_PIXELS=1024
MOBILE_CAPTURE_JPEG_QUALITY=72

# Non-container production must set dedicated runtime paths. Dockerfile already
# supplies the corresponding /app/runtime paths.
# USERS_JSON_PATH=/srv/focalcove-example/runtime/users.json
# USER_DATA_JSON_DIR=/srv/focalcove-example/runtime/user_data
# USER_HISTORY_JSON_DIR=/srv/focalcove-example/runtime/user_history
